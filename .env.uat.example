# UAT environment template for /opt/ie-orbit-uat/.env
# Preferred: copy production .env then run scripts/sync-uat-env-from-prod.sh
# so secrets stay the same. Host keys below must differ from prod.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api-uat.ie-orbit.com,app-uat.ie-orbit.com,uat.ie-orbit.com,ops-uat.ie-orbit.com,127.0.0.1,localhost,backend
DJANGO_LOG_LEVEL=INFO

POSTGRES_USER=ie_orbit
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=ie_orbit
DATABASE_URL=postgresql://ie_orbit:replace-with-a-strong-postgres-password@postgres:5432/ie_orbit
REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=no-reply@ie-orbit.com
CORS_ALLOWED_ORIGINS=https://uat.ie-orbit.com,https://app-uat.ie-orbit.com,https://ops-uat.ie-orbit.com
CSRF_TRUSTED_ORIGINS=https://api-uat.ie-orbit.com,https://uat.ie-orbit.com,https://app-uat.ie-orbit.com,https://ops-uat.ie-orbit.com
FRONTEND_BASE_URL=https://uat.ie-orbit.com
PUBLIC_API_ORIGIN=https://api-uat.ie-orbit.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
CELERY_TASK_ALWAYS_EAGER=false

API_HOST=api-uat.ie-orbit.com
WEB_HOST=app-uat.ie-orbit.com
SITE_HOST=uat.ie-orbit.com
WWW_HOST=uat.ie-orbit.com
OPS_WEB_HOST=ops-uat.ie-orbit.com
VITE_PUBLIC_SITE_URL=https://uat.ie-orbit.com
VITE_ADMIN_APP_URL=https://app-uat.ie-orbit.com
VITE_OPS_MOBILE_WEB_URL=https://ops-uat.ie-orbit.com
VITE_OPS_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.ieorbit.ops&hl=en_IN
# VITE_OPS_IOS_STORE_URL=
VITE_GA_MEASUREMENT_ID=G-3Z5PSGMWJW
EXPO_PUBLIC_API_BASE_URL=https://api-uat.ie-orbit.com/api/v1
EXPO_PUBLIC_REFERRAL_LINK_BASE_URL=https://uat.ie-orbit.com
EXPO_PUBLIC_APP_DOWNLOAD_URL=https://uat.ie-orbit.com/download

GUNICORN_WORKERS=1
GUNICORN_THREADS=8
CELERY_CONCURRENCY=1

PLATFORM_MEDIA_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ie-orbit-media
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_PUBLIC=86400
R2_SIGNED_URL_TTL_PRIVATE=900

BACKUP_S3_PREFIX=backups/postgres-uat
BACKUP_LOCAL_RETENTION_DAYS=7

GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_OPS_IOS_CLIENT_ID=
GOOGLE_OAUTH_OPS_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_CUSTOMER_ANDROID_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
PLATFORM_UPI_VPA=
PLATFORM_UPI_NAME=IE Orbit
PLATFORM_PAYMENT_QR_URL=
EXPO_ACCESS_TOKEN=
# Customer white-label APK from Platform Admin (same machine token as GitHub secret).
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-management.json
# CUSTOMER_APK_GITHUB_REPO=indiansempiregroup-beep/ie-orbit
# CUSTOMER_APK_GITHUB_TOKEN=
# CUSTOMER_APK_MACHINE_TOKEN=
# CUSTOMER_APK_GITHUB_REF=uat
# CUSTOMER_APK_WORKFLOW=customer-apk.yml
ADMIN_HOST=
VITE_GOOGLE_PLACES_API_KEY=
