# Copy to e2e/.env and fill from IMP vault (~/Sanket/IMP/ie-orbit-qa-credentials.md).
# Never commit e2e/.env.
#
# Production smoke (default):
#   QA_BASE_URL=https://ie-orbit.com
#   QA_OPS_URL=https://ops.ie-orbit.com
#   QA_ADMIN_URL=https://app.ie-orbit.com
#   QA_API_URL=https://api.ie-orbit.com/api/v1
#
# UAT (preferred for mutating CRUD — dedicated e2e-qa tenant):
QA_BASE_URL=https://uat.ie-orbit.com
QA_OPS_URL=https://ops-uat.ie-orbit.com
QA_ADMIN_URL=https://app-uat.ie-orbit.com
QA_API_URL=https://api-uat.ie-orbit.com/api/v1

# Ops / tenant owner (ops-uat.ie-orbit.com + native ops APK). Sign-in is OTP-only; password is unused.
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=
QA_STAFF_EMAIL=

# Customer mobile app smoke login
QA_CUSTOMER_EMAIL=
QA_CUSTOMER_PASSWORD=

# Platform admin (app-uat.ie-orbit.com) — must not also have a tenant ops role.
QA_PLATFORM_ADMIN_EMAIL=
QA_PLATFORM_ADMIN_PASSWORD=
