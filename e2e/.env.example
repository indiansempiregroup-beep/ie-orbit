# Copy to e2e/.env and fill from IMP vault (~/Sanket/IMP/ie-orbit-qa-credentials.md).
# Never commit e2e/.env.

QA_BASE_URL=https://ie-orbit.com
QA_OPS_URL=https://ops.ie-orbit.com
QA_API_URL=https://api.ie-orbit.com/api/v1

# Ops / tenant owner (ops.ie-orbit.com + native ops APK)
QA_OWNER_EMAIL=
QA_OWNER_PASSWORD=

# Customer mobile app smoke login
QA_CUSTOMER_EMAIL=
QA_CUSTOMER_PASSWORD=

# Optional — platform admin (app.ie-orbit.com)
QA_PLATFORM_ADMIN_EMAIL=
QA_PLATFORM_ADMIN_PASSWORD=
