# Production environment template. Copy to `.env` on the VPS.
# Do not commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.ie-orbit.com,app.ie-orbit.com,ie-orbit.com,www.ie-orbit.com,127.0.0.1,localhost,backend
DJANGO_LOG_LEVEL=INFO

POSTGRES_USER=ie_orbit
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=ie_orbit
DATABASE_URL=postgresql://ie_orbit:replace-with-a-strong-postgres-password@postgres:5432/ie_orbit
REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=no-reply@ie-orbit.com
CORS_ALLOWED_ORIGINS=https://ie-orbit.com,https://www.ie-orbit.com,https://app.ie-orbit.com,https://ops.ie-orbit.com
CSRF_TRUSTED_ORIGINS=https://api.ie-orbit.com,https://ie-orbit.com,https://www.ie-orbit.com,https://app.ie-orbit.com,https://ops.ie-orbit.com
FRONTEND_BASE_URL=https://ie-orbit.com
PUBLIC_API_ORIGIN=https://api.ie-orbit.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
CELERY_TASK_ALWAYS_EAGER=false

API_HOST=api.ie-orbit.com
WEB_HOST=app.ie-orbit.com
SITE_HOST=ie-orbit.com
WWW_HOST=www.ie-orbit.com
OPS_WEB_HOST=ops.ie-orbit.com
VITE_PUBLIC_SITE_URL=https://ie-orbit.com
VITE_ADMIN_APP_URL=https://app.ie-orbit.com
VITE_OPS_MOBILE_WEB_URL=https://ops.ie-orbit.com
EXPO_PUBLIC_API_BASE_URL=https://api.ie-orbit.com/api/v1
EXPO_PUBLIC_REFERRAL_LINK_BASE_URL=https://ie-orbit.com
EXPO_PUBLIC_APP_DOWNLOAD_URL=https://ie-orbit.com/download

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
CELERY_CONCURRENCY=1

PLATFORM_MEDIA_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ie-orbit-media
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_PUBLIC=86400
R2_SIGNED_URL_TTL_PRIVATE=900

BACKUP_S3_PREFIX=backups/postgres
BACKUP_LOCAL_RETENTION_DAYS=7
# Optional backup overrides. If unset, backup scripts reuse the R2 variables above.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=auto

GOOGLE_PLACES_API_KEY=
# Google Sign-In (Gmail). One Web client ID is shared by ie-orbit.com, ops, and
# customer apps. Add https://ie-orbit.com and https://ops.ie-orbit.com as
# Authorized JavaScript origins and redirect URIs on that same Web client.
# Rebuild nginx after changing so Vite embeds VITE_GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_OPS_IOS_CLIENT_ID=
GOOGLE_OAUTH_OPS_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_CUSTOMER_ANDROID_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
PLATFORM_UPI_VPA=
PLATFORM_UPI_NAME=IE Orbit
PLATFORM_PAYMENT_QR_URL=
EXPO_ACCESS_TOKEN=
ADMIN_HOST=
VITE_GOOGLE_PLACES_API_KEY=

# Optional billing ops (see docs/Phase6-Ops-Readiness-Runbook.md).
# BILLING_OPS_DIGEST_ENABLED=true
# BILLING_OPS_DIGEST_RECIPIENTS=ops@example.com
# BILLING_OPS_DIGEST_HOUR_UTC=2
# BILLING_WEBHOOK_ALERT_RECIPIENTS=ops@example.com
# BILLING_ENFORCE_LIVE_CHECKOUT=false
# BILLING_RECONCILIATION_LOOKBACK_HOURS=72
# BILLING_PLAN_PRICE_OVERRIDES={}
# BILLING_CURRENCY_DEFAULT=INR
