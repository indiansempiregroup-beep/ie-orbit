############################################################

node_modules/
.pnpm-store/
.npm/
.yarn/

############################################################
# React / Vite
############################################################

dist/
coverage/

############################################################
# Expo
############################################################

.expo/
.expo-shared/
web-build/

# Firebase / FCM — keep *.example.json; never commit service accounts
google-services.json
GoogleService-Info.plist
*-firebase-adminsdk-*.json
**/credentials/google-services/*.json
!**/google-services.example.json
# Upload the local ops FCM client file so production-preview can receive push.
!apps/ops-mobile/credentials/google-services.json

############################################################
