{
  "name": "@ie-orbit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:demo": "EXPO_PUBLIC_FLAVOR_KEY=demo-MAIN EXPO_PUBLIC_APP_NAME='Demo Salon' expo start",
    "start:empire": "EXPO_PUBLIC_FLAVOR_KEY=empire-salon-main EXPO_PUBLIC_APP_NAME='Empire Salon' expo start",
    "start:rupali": "EXPO_PUBLIC_FLAVOR_KEY=rupali-s-business-rupali-s-business EXPO_PUBLIC_APP_NAME='Rupali Sirsat' expo start",
    "start:rupali:tunnel": "EXPO_PUBLIC_FLAVOR_KEY=rupali-s-business-rupali-s-business EXPO_PUBLIC_APP_NAME='Rupali Sirsat' expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:build:demo:preview": "bash ./scripts/build-flavor.sh demo-main-preview all",
    "eas:build:demo:production-preview": "bash ./scripts/build-flavor.sh demo-main-production-preview android",
    "eas:build:demo:production": "bash ./scripts/build-flavor.sh demo-main-production all",
    "eas:build:empire:preview": "bash ./scripts/build-flavor.sh empire-salon-preview all",
    "eas:build:empire:production-preview": "bash ./scripts/build-flavor.sh empire-salon-production-preview android",
    "eas:build:empire:production": "bash ./scripts/build-flavor.sh empire-salon-production all",
    "eas:build:rupali:preview": "bash ./scripts/build-flavor.sh rupali-sirsat-preview all",
    "eas:build:rupali:production-preview": "bash ./scripts/build-flavor.sh rupali-sirsat-production-preview android",
    "eas:build:rupali:production": "bash ./scripts/build-flavor.sh rupali-sirsat-production all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@ie-orbit/i18n": "workspace:*",
    "@ie-orbit/sdk": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "expo": "^54.0.35",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "^8.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~16.1.6",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "^3.0.9",
    "i18next": "^25.3.2",
    "react": "^19.1.0",
    "react-i18next": "^15.6.1",
    "react-native": "^0.81.5",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "^19.1.17",
    "eas-cli": "^22.6.0",
    "typescript": "^5.9.3"
  }
}
