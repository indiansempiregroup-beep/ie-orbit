# Copy to the VPS as /opt/ie-platform/.env (never commit the real file).
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO

# IP-only trial: use the VPS public IPv4 and keep SSL redirect off.
# Domain + TLS: set the hostname, https origins, and DJANGO_SECURE_SSL_REDIRECT=true.
DJANGO_ALLOWED_HOSTS=YOUR_VPS_IP
DJANGO_SECURE_SSL_REDIRECT=false
CORS_ALLOWED_ORIGINS=http://YOUR_VPS_IP
CSRF_TRUSTED_ORIGINS=http://YOUR_VPS_IP
PUBLIC_API_ORIGIN=http://YOUR_VPS_IP

# Caddy site address. :80 = HTTP on all interfaces. Use your domain for Let's Encrypt.
CADDY_SITE_ADDRESS=:80
ACME_EMAIL=

POSTGRES_DB=ie_platform
POSTGRES_USER=ie_platform
POSTGRES_PASSWORD=replace-with-a-strong-db-password
DATABASE_URL=postgresql://ie_platform:replace-with-a-strong-db-password@postgres:5432/ie_platform
REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=no-reply@localhost
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
CELERY_TASK_ALWAYS_EAGER=false

GUNICORN_WORKERS=2
SEED_PILOT=true
DEPLOY_BRANCH=main

PLATFORM_UPI_VPA=ieplatform@upi
PLATFORM_UPI_NAME=IE Platform
PLATFORM_PAYMENT_QR_URL=
GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=
