DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web
DJANGO_LOG_LEVEL=INFO

# Host Postgres (default). Use host.docker.internal from Compose; use localhost if running Django on the host.
DATABASE_URL=postgresql://postgres:admin@host.docker.internal:5432/ie_orbit
# Optional: keep using Neon instead by pasting your Neon pooler URL here.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional named Neon URL (do not put real credentials in this example file).
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=no-reply@localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082,http://127.0.0.1:8082
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082,http://127.0.0.1:8082
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
CELERY_TASK_ALWAYS_EAGER=false

# Optional: OCR.space key for packaging photo text extraction (falls back to Tesseract in Docker).
# OCR_SPACE_API_KEY=

# ---------------------------------------------------------------------------
# Google Maps Platform — one unrestricted API key in GOOGLE_PLACES_API_KEY.
# Enable billing. Enable Places API (+ New if listed), Maps JavaScript API,
# Maps Embed API, Maps SDK for Android. Do not enable Directions / Distance Matrix.
# Leave the VITE_/EXPO_ lines blank; loaders copy the same key. Restart apps after change.
# Optional: a Cloud budget alert so a leaked unrestricted key cannot run unbounded.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
# Leave these blank in most setups; scripts/load-root-env.cjs copies the key above.
# Set them only if you need an Expo-specific override.
# EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_PLACES_API_KEY=
# ---------------------------------------------------------------------------
# Google Sign-In (Gmail) — one Web OAuth client ID for the public site, ops, and
# customer apps. Do not create a second Web client. On that client, add
# Authorized JavaScript origins AND Authorized redirect URIs (no trailing slash).
# Google also wants the host without a port for local GIS:
#   http://localhost
#   http://127.0.0.1
#   http://localhost:8082
#   http://127.0.0.1:8082
#   http://localhost:3000
#   http://127.0.0.1:3000
#   https://ops.ie-orbit.com
#   https://ie-orbit.com
# Expo Go cannot complete Google login (Google rejects exp://). Press w in Expo
# and sign in from the browser. Leave Expo blank; load-root-env.cjs copies this
# into EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID and VITE_GOOGLE_OAUTH_CLIENT_ID.
# Restart backend, Expo, and the Vite public site after changing.
# Ops iOS/Android clients are optional until you ship a native ops build.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_OPS_IOS_CLIENT_ID=
GOOGLE_OAUTH_OPS_ANDROID_CLIENT_ID=
# Google AdMob app IDs and banner units. AdMob requires native development/EAS
# builds; Expo Go safely skips the banner. Customer app IDs are per flavor build.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_OPS_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_OPS_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_OPS_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_OPS_IOS_BANNER_UNIT_ID=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Public site vs Platform Admin vs Expo ops — same split as production.
# Local:  localhost:3000 = website, 127.0.0.1:3000 = admin, localhost:8082 = Expo.
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_ADMIN_APP_URL=http://127.0.0.1:3000
VITE_OPS_MOBILE_WEB_URL=http://localhost:8082
# HTTPS landing domain used by referral links. It must host /invite and the
# Apple/Android app-association files for installed-app deep links.
EXPO_PUBLIC_REFERRAL_LINK_BASE_URL=https://example.com
# App Store / Play Store landing page used when the app is not installed.
EXPO_PUBLIC_APP_DOWNLOAD_URL=https://example.com/download
# Optional Zoho-style dedicated admin host (backend only). Example: admin.localhost
ADMIN_HOST=
# Optional customer-mobile flavor overrides (also settable in the shell):
# EXPO_PUBLIC_FLAVOR_KEY=
# EXPO_PUBLIC_APP_NAME=
# EXPO_PUBLIC_MOBILE_DEV_MODE=true
# EXPO_PUBLIC_TENANT_SLUG=
# EXPO_PUBLIC_BUSINESS_CODE=
# EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_PUBLIC_OPS_EAS_PROJECT_ID=
# Required for EAS Android/iOS push tokens (getExpoPushTokenAsync). Set the same
# value in EAS build env. google-services.json is local/EAS only — not used by Django.
#
# Optional Expo Push API access token (Authorization: Bearer). Improves production
# send reliability. Create at https://expo.dev/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# Platform subscription UPI (ops-mobile amount QR + claim)
PLATFORM_UPI_VPA=ieorbit@upi
PLATFORM_UPI_NAME=IE Orbit
PLATFORM_PAYMENT_QR_URL=

# ---------------------------------------------------------------------------
# Platform Razorpay account — collects SaaS subscription payments from tenants.
# Keys come from Razorpay Dashboard -> Settings -> API Keys. Add a webhook for
# POST <backend>/api/v1/billing/webhooks/razorpay and paste its signing secret
# below. Merchants connect their own Razorpay under Settings -> Payments; those
# credentials are stored per business and are unrelated to these keys.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Platform Cashfree account — optional second PG for SaaS subscription payments.
# Keys come from Cashfree Dashboard -> Developers -> API Keys. Add a webhook for
# POST <backend>/api/v1/billing/webhooks/cashfree. Merchants connect their own
# Cashfree under Settings -> Payments independently of these keys.
# CASHFREE_ENV is sandbox or production.
# ---------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---------------------------------------------------------------------------
# Platform media storage. Use local for development. Production Compose uses r2
# (S3-compatible Cloudflare R2). The factory stores provider code as s3.
# ---------------------------------------------------------------------------
PLATFORM_MEDIA_STORAGE_PROVIDER=local
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_PUBLIC=86400
R2_SIGNED_URL_TTL_PRIVATE=900
BACKUP_S3_PREFIX=backups/postgres
BACKUP_LOCAL_RETENTION_DAYS=
