DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web
DJANGO_LOG_LEVEL=INFO

# Local Docker Postgres (default). Host is `postgres` inside compose; use `localhost` if running Django on the host.
DATABASE_URL=postgresql://ie:ie@postgres:5432/ie_platform
# Optional: keep using Neon instead by pasting your Neon pooler URL here.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=no-reply@localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
CELERY_TASK_ALWAYS_EAGER=false
