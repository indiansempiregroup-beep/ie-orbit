DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,web,192.168.1.5,172.20.10.5
DJANGO_LOG_LEVEL=INFO

# Host Postgres (default). Use host.docker.internal from Compose; use localhost if running Django on the host.
DATABASE_URL=postgresql://postgres:admin@host.docker.internal:5432/ie_orbit
# Optional: keep using Neon instead by pasting your Neon pooler URL here.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional named Neon URL (do not put real credentials in this example file).
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://redis:6379/0

DEFAULT_FROM_EMAIL=no-reply@localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082,http://127.0.0.1:8082,http://192.168.1.11:8082
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8082,http://127.0.0.1:8082,http://192.168.1.11:8082
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
CELERY_TASK_ALWAYS_EAGER=false

# Optional: OCR.space key for packaging photo text extraction (falls back to Tesseract in Docker).
# OCR_SPACE_API_KEY=

# ---------------------------------------------------------------------------
# Google Maps — one unrestricted key (web, Django Places proxy, Android maps).
# Enable billing. Enable Places API (+ New if listed), Maps JavaScript API,
# Maps Embed API, Maps SDK for Android. Do not enable Directions / Distance Matrix.
# Leave the VITE_/EXPO_ lines blank; loaders copy the same key. Restart apps after change.
# Optional: a Cloud budget alert so a leaked unrestricted key cannot run unbounded.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=AIzaSyBAPlSIcXzgy26Lv0n64wAC2A_dzXMYiO0
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=AIzaSyBAPlSIcXzgy26Lv0n64wAC2A_dzXMYiO0
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBAPlSIcXzgy26Lv0n64wAC2A_dzXMYiO0
# Google Sign-In. Web ID is shared. Ops iOS/Android IDs are for native ops builds only.
GOOGLE_OAUTH_CLIENT_ID=373269001775-493p9n4iglmilp2i0990q3n19sfjpr6k.apps.googleusercontent.com
GOOGLE_OAUTH_OPS_IOS_CLIENT_ID=373269001775-49atdugpkab4ul3v8vpaed9l65e8e3ib.apps.googleusercontent.com
GOOGLE_OAUTH_OPS_ANDROID_CLIENT_ID=373269001775-uaeuvfkvk9ej2g5arcg6emghau5239ib.apps.googleusercontent.com
GOOGLE_OAUTH_CUSTOMER_ANDROID_CLIENT_ID=373269001775-3fm125kisnkfcjbvqji1vtvegm2326na.apps.googleusercontent.com
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.11:8000/api/v1
# HTTPS landing domain used by referral links. It must host /invite and the
# Apple/Android app-association files for installed-app deep links.
EXPO_PUBLIC_REFERRAL_LINK_BASE_URL=https://app.ie-orbit.com
# App Store / Play Store landing page used when the app is not installed.
EXPO_PUBLIC_APP_DOWNLOAD_URL=https://app.ie-orbit.com/download
# Optional Zoho-style dedicated admin host (backend only). Example: admin.localhost
ADMIN_HOST=
# Same host split as production: website vs Platform Admin vs Expo ops.
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_ADMIN_APP_URL=http://127.0.0.1:3000
VITE_OPS_MOBILE_WEB_URL=http://localhost:8082
# Optional customer-mobile flavor overrides (also settable in the shell):
# EXPO_PUBLIC_FLAVOR_KEY=
# EXPO_PUBLIC_APP_NAME=
# EXPO_PUBLIC_MOBILE_DEV_MODE=true
# EXPO_PUBLIC_TENANT_SLUG=
# EXPO_PUBLIC_BUSINESS_CODE=
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Platform subscription UPI (ops-mobile amount QR + claim)
PLATFORM_UPI_VPA=ieorbit@upi
PLATFORM_UPI_NAME=IE Orbit
PLATFORM_PAYMENT_QR_URL=


EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-1258778965386332~2750313610
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-1258778965386332~4831505872
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-1258778965386332/9124150278
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-1258778965386332/8686105928

EXPO_PUBLIC_ADMOB_OPS_ANDROID_APP_ID=ca-app-pub-1258778965386332~9504363579
EXPO_PUBLIC_ADMOB_OPS_IOS_APP_ID=ca-app-pub-1258778965386332~8402095545
EXPO_PUBLIC_ADMOB_OPS_BANNER_UNIT_ID=ca-app-pub-1258778965386332/8191281902
EXPO_PUBLIC_ADMOB_OPS_IOS_BANNER_UNIT_ID=ca-app-pub-1258778965386332/8579179192

EXPO_PUBLIC_EAS_PROJECT_ID=d3605998-b92a-497d-a72f-8028df3ca64d
EXPO_PUBLIC_OPS_EAS_PROJECT_ID=b897b310-e21b-49ab-b58f-56b8da1867f3

# ---------------------------------------------------------------------------
# Platform Razorpay account — collects SaaS subscription payments from tenants.
# Keys come from Razorpay Dashboard -> Settings -> API Keys. Add a webhook for
# POST <backend>/api/v1/billing/webhooks/razorpay and paste its signing secret
# below. Merchants connect their own Razorpay under Settings -> Payments; those
# credentials are stored per business and are unrelated to these keys.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# ---------------------------------------------------------------------------
# Platform Cashfree account — optional second PG for SaaS subscription payments.
# Keys come from Cashfree Dashboard -> Developers -> API Keys. Add a webhook for
# POST <backend>/api/v1/billing/webhooks/cashfree. Merchants connect their own
# Cashfree under Settings -> Payments independently of these keys.
# CASHFREE_ENV is sandbox or production.
# ---------------------------------------------------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ---------------------------------------------------------------------------
# Platform media storage. Use local for development. Production Compose uses r2
# (S3-compatible Cloudflare R2). The factory stores provider code as s3.
# ---------------------------------------------------------------------------
PLATFORM_MEDIA_STORAGE_PROVIDER=r2
R2_ENDPOINT=https://bbcf0d9e20ccf7ed7a21488110cca078.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=5eb1b8af071932bff402a1a14adbb2a9
R2_SECRET_ACCESS_KEY=c75833a4bbfe43868798f25de6cfed1e6b7011bebc3b5f9fa6d4089adf49af88
R2_BUCKET_NAME=ie-orbit-uat
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_PUBLIC=86400
R2_SIGNED_URL_TTL_PRIVATE=900
BACKUP_S3_PREFIX=backups/postgres
BACKUP_LOCAL_RETENTION_DAYS=7
